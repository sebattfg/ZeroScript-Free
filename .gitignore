# Build output: dist/ is committed on purpose (the repository is the download),
# but temporary exe/PyInstaller output is not.
dist/exe/
dist/_pyinstaller/

# Controller runtime data: settings.json + timeline memory (local, private)
controller/data/

# Python
__pycache__/
*.py[cod]
.venv/

# Archives elsewhere in the tree (release zips in dist/ are tracked)
*.zip
!dist/*.zip

# Node (parser test tooling only)
node_modules/

# Godot / editor noise
.godot/
*.translation

# System files
.DS_Store
Thumbs.db
desktop.ini

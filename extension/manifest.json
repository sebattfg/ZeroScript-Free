{
  "manifest_version": 3,
  "name": "NonZeroScript · Godot AI Agent",
  "version": "0.2.0",
  "description": "Turn ChatGPT, DeepSeek, Gemini, Kimi, GLM, Qwen, Meta AI or Arena into a Godot 4.7.2 editor agent. Browser extension + local controller + editor plugin.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chat.deepseek.com/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*",
    "https://www.kimi.ai/*",
    "https://kimi.ai/*",
    "https://chat.z.ai/*",
    "https://z.ai/*",
    "https://chat.qwen.ai/*",
    "https://arena.ai/*",
    "https://www.arena.ai/*",
    "https://www.meta.ai/*",
    "https://meta.ai/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "NonZeroScript · Godot",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "core/config.js",
        "core/parser.js",
        "providers/deepseek.js",
        "core/net.js",
        "core/main.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "providers/chatgpt-cm.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "core/config.js",
        "core/parser.js",
        "providers/chatgpt.js",
        "core/net.js",
        "core/main.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": [
        "core/config.js",
        "core/parser.js",
        "providers/gemini.js",
        "core/net.js",
        "core/main.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.kimi.ai/*",
        "https://kimi.ai/*"
      ],
      "js": [
        "core/config.js",
        "core/parser.js",
        "providers/kimi.js",
        "core/net.js",
        "core/main.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chat.z.ai/*",
        "https://z.ai/*"
      ],
      "js": [
        "core/config.js",
        "core/parser.js",
        "providers/glm.js",
        "core/net.js",
        "core/main.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://arena.ai/*",
        "https://www.arena.ai/*"
      ],
      "js": [
        "core/config.js",
        "core/parser.js",
        "providers/arena.js",
        "core/net.js",
        "core/main.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.meta.ai/*",
        "https://meta.ai/*"
      ],
      "js": [
        "core/config.js",
        "core/parser.js",
        "providers/meta.js",
        "core/net.js",
        "core/main.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chat.qwen.ai/*"
      ],
      "js": [
        "providers/qwen-net.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chat.qwen.ai/*"
      ],
      "js": [
        "core/config.js",
        "core/parser.js",
        "providers/qwen.js",
        "core/net.js",
        "core/main.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    }
  ]
}

# Shell launchers MUST keep LF endings: a CRLF checkout makes bash fail on
# macOS/Linux with "$'\r': command not found". The repo is developed on
# Windows (autocrlf), so pin these explicitly.
*.command text eol=lf
*.sh       text eol=lf

# Windows launchers: CRLF is what cmd.exe expects.
*.bat      text eol=crlf

# Godot sources and plugin metadata.
*.gd       text eol=lf
*.cs       text eol=lf
*.csproj   text eol=lf
*.sln      text eol=lf
*.cfg      text eol=lf
